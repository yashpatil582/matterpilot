<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  MatterPilot Outlook add-in manifest.

  Sideload steps (Outlook desktop):
    File → Manage Add-ins → My add-ins → Add a custom add-in → from file…
    Pick this file. Outlook will fetch the task pane URL from SourceLocation
    below; that URL must serve over HTTPS at the production deployment.

  Replace https://matterpilot-demo.vercel.app with your own Vercel URL if
  you are running a fork. The path /addins/outlook/taskpane.html is
  served by the Next.js app via the rewrite in next.config.ts.

  Replace the Id with a fresh GUID before publishing — every distinct
  add-in install needs its own unique Id.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>11111111-2222-3333-4444-555555555555</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>MatterPilot (FDE demo)</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="MatterPilot" />
  <Description DefaultValue="MatterPilot — summarize threads, extract deadlines, and file attachments to a matter." />
  <IconUrl DefaultValue="https://matterpilot-demo.vercel.app/addins/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://matterpilot-demo.vercel.app/addins/icon-128.png" />
  <SupportUrl DefaultValue="https://matterpilot-demo.vercel.app/sign-in" />

  <AppDomains>
    <AppDomain>https://matterpilot-demo.vercel.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://matterpilot-demo.vercel.app/addins/outlook/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" />
    <Rule xsi:type="ItemIs" ItemType="Appointment" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFile.url" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="msgReadOpenPane">
                  <Label resid="openPaneButton.label" />
                  <Supertip>
                    <Title resid="openPaneButton.title" />
                    <Description resid="openPaneButton.tip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon-16" />
                    <bt:Image size="32" resid="icon-32" />
                    <bt:Image size="80" resid="icon-80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpane.url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon-16" DefaultValue="https://matterpilot-demo.vercel.app/addins/icon-16.png" />
        <bt:Image id="icon-32" DefaultValue="https://matterpilot-demo.vercel.app/addins/icon-32.png" />
        <bt:Image id="icon-80" DefaultValue="https://matterpilot-demo.vercel.app/addins/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpane.url" DefaultValue="https://matterpilot-demo.vercel.app/addins/outlook/taskpane.html" />
        <bt:Url id="functionFile.url" DefaultValue="https://matterpilot-demo.vercel.app/addins/outlook/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="MatterPilot" />
        <bt:String id="openPaneButton.label" DefaultValue="Open MatterPilot" />
        <bt:String id="openPaneButton.title" DefaultValue="MatterPilot" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="openPaneButton.tip" DefaultValue="Summarize the thread, extract deadlines, and file to a matter." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
