# Postgres connection string (Neon free tier: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq API key (free tier: https://console.groq.com/keys)
GROQ_API_KEY=

# LLM model default. Day 6 consolidated classify + extract into one tool-use
# call, so only one model is used end-to-end.
LLM_PROVIDER=groq
LLM_MODEL_CLASSIFY=llama-3.3-70b-versatile

# File storage — Vercel Blob token (free tier on Vercel)
BLOB_READ_WRITE_TOKEN=

# Confidence threshold below which notices route to human review (0..1)
REVIEW_CONFIDENCE_THRESHOLD=0.75

# Auth.js v5 — REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js v5 — OPTIONAL OIDC providers. Each pair is registered only if both
# values are set; otherwise the provider is omitted from the sign-in page.
AUTH_MICROSOFT_ENTRA_ID=
AUTH_MICROSOFT_ENTRA_SECRET=
AUTH_MICROSOFT_ENTRA_ISSUER=          # optional, defaults to the Entra v2 endpoint
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev credentials sign-in. Active in non-production by default. Set to 'true'
# to enable in production (NOT recommended outside a demo environment).
AUTH_DEV_LOGIN=
